# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# DEEP_API_KEY or DEEPSEEK_API_KEY: Configured in Secrets for DeepSeek AI
DEEP_API_KEY="MY_DEEPSEEK_API_KEY"

# AISA_API_KEY: Unified gateway key for 100+ models (AISA.one)
AISA_API_KEY="MY_AISA_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
